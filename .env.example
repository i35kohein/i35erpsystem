# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DeepSeek server-side key. Keep the real value only in the server's .env file;
# do not put it in the browser settings or commit it to GitHub.
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# OpenRouter server-side key (optional). Enables Claude Opus / any OpenRouter
# model from the Telegram bot and as a fallback when the browser settings have
# no key. Model IDs like anthropic/claude-opus-5 work via Settings → AI.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Leave disabled for all real/live data environments. Set to true only for a
# separate demo Supabase project when sample data is intentionally required.
VITE_ENABLE_DEMO_SEED="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# Military-grade security (Ko Hein 2026-08-13)
# =============================================================================
# Login credentials (required)
AUTH_EMAIL="admin@your-shop.com"
# Legacy plaintext password — kept for backward compat, but PREFERRED is the
# scrypt hash below. Generate with: node scripts/hash-password.mjs <password>
# AUTH_PASSWORD="change-me"
AUTH_PASSWORD_HASH="scrypt:<saltHex>:<hashHex>"

# Server-side Supabase (service role — SERVER ONLY, never in VITE_*)
# The client no longer talks to Supabase directly; all data flows through the
# authenticated /api/data/* proxy. Without these the app can't load data.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE="eyJ...service_role...never-expose-to-browser"

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_IDS=""
TELEGRAM_AI_MODEL=""
